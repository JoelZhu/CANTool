            <!-- 第 0 行：提示标签 -->
            <item row="0" column="0" colspan="10">
                <widget class="QLabel" name="labelHint">
                    <property name="text">
                        <string>
                            Select a BLF file below, and the convert button will convert the BLF to ASC.&lt;br/&gt;
