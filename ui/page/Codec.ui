<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <class>CodecWidget</class>
    <widget class="QWidget" name="CodecWidget">
        <layout class="QVBoxLayout" name="verticalLayout">
            <!-- 内容容器 -->
            <item>
                <widget class="QWidget" name="contentWidget" native="true">
                    <layout class="QGridLayout" name="gridLayout">
                        <property name="horizontalSpacing">
                            <number>8</number>
                        </property>
                        <property name="verticalSpacing">
                            <number>8</number>
                        </property>

                        <!-- 第 0 行：Message Data 标签 -->
                        <item row="0" column="0" colspan="8">
                            <widget class="QLabel" name="labelData">
                                <property name="text">
                                    <string>【CAN Message】</string>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 1 行：提示标签 -->
                        <item row="1" column="0" colspan="8">
                            <widget class="QLabel" name="labelHint">
                                <property name="text">
                                    <string>
                                        Format in hex, each byte separated by space or comma.&lt;br/&gt;
                                        Bytes order like: Byte0 Byte1 ...&lt;br/&gt;
                                        For example: 00 01 98 00 or 00,01,98,00
                                    </string>
                                </property>
                                <property name="wordWrap">
                                    <bool>true</bool>
                                </property>
                                <property name="styleSheet">
                                    <string notr="true">color: gray; font-size: 9pt;</string>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 2 行：数据输入框 -->
                        <item row="2" column="0" colspan="8">
                            <widget class="QLineEdit" name="editData">
                                <property name="placeholderText">
                                    <string>Enter hex bytes...</string>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 3 行：Parse 按钮 -->
                        <item row="3" column="0" colspan="8" alignment="Qt::AlignHCenter">
                            <widget class="QPushButton" name="buttonParse">
                                <property name="sizePolicy">
                                    <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
                                        <horstretch>0</horstretch>
                                        <verstretch>0</verstretch>
                                    </sizepolicy>
                                </property>
                                <property name="text">
                                    <string>Parse</string>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 4 行：分析结果标题 -->
                        <item row="4" column="0" colspan="8">
                            <widget class="QLabel" name="labelWatcher">
                                <property name="text">
                                    <string>【Parsed Result】</string>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 5 行：结果标签（Raw Value、Physical Value） -->
                        <item row="5" column="2">
                            <widget class="QLabel" name="labelRaw">
                                <property name="text">
                                    <string>Raw Value</string>
                                </property>
                            </widget>
                        </item>
                        <item row="5" column="3">
                            <widget class="QLineEdit" name="editRaw">
                                <property name="readOnly">
                                    <bool>true</bool>
                                </property>
                            </widget>
                        </item>
                        <item row="5" column="4">
                            <widget class="QLabel" name="labelPhysical">
                                <property name="text">
                                    <string>Physical Value</string>
                                </property>
                            </widget>
                        </item>
                        <item row="5" column="5">
                            <widget class="QLineEdit" name="editPhysical">
                                <property name="readOnly">
                                    <bool>true</bool>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 6 行：分割线 -->
                        <item row="6" column="0" colspan="8">
                            <widget class="QWidget" name="lineContainer">
                                <layout class="QVBoxLayout" name="lineContainerLayout">
                                    <item>
                                        <widget class="QFrame" name="horizontalLine">
                                            <property name="frameShape">
                                                <enum>QFrame::HLine</enum>
                                            </property>
                                            <property name="frameShadow">
                                                <enum>QFrame::Sunken</enum>
                                            </property>
                                        </widget>
                                    </item>
                                </layout>
                            </widget>
                        </item>

                        <!-- 第 7 行：输入值标签 -->
                        <item row="7" column="0" colspan="8">
                            <widget class="QLabel" name="labelParserResult">
                                <property name="text">
                                    <string>【Value】</string>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 8 行：Raw Value、Physical Value -->
                        <item row="8" column="2">
                            <widget class="QRadioButton" name="radioRaw">
                                <property name="text">
                                    <string>Raw Value</string>
                                </property>
                                <property name="checked">
                                    <bool>true</bool>
                                </property>
                            </widget>
                        </item>
                        <item row="8" column="3">
                            <widget class="QSpinBox" name="spinRaw">
                                <property name="minimum">
                                    <number>0</number>
                                </property>
                                <property name="value">
                                    <number>0</number>
                                </property>
                                <property name="maximum">
                                    <number>999999</number>
                                </property>
                            </widget>
                        </item>
                        <item row="8" column="4">
                            <widget class="QRadioButton" name="radioPhysical">
                                <property name="text">
                                    <string>Physical Value</string>
                                </property>
                            </widget>
                        </item>
                        <item row="8" column="5">
                            <widget class="QDoubleSpinBox" name="spinPhysical">
                                <property name="decimals">
                                    <number>6</number>
                                </property>
                                <property name="minimum">
                                    <double>-1000000.000000</double>
                                </property>
                                <property name="maximum">
                                    <double>1000000.000000</double>
                                </property>
                                <property name="value">
                                    <double>0.000000</double>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 9 行：Generate 按钮 -->
                        <item row="9" column="0" colspan="8" alignment="Qt::AlignHCenter">
                            <widget class="QPushButton" name="buttonGenerate">
                                <property name="sizePolicy">
                                    <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
                                        <horstretch>0</horstretch>
                                        <verstretch>0</verstretch>
                                    </sizepolicy>
                                </property>
                                <property name="text">
                                    <string>Generate</string>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 10 行：结果标签 -->
                        <item row="10" column="0" colspan="8">
                            <widget class="QLabel" name="labelGeneratorResult">
                                <property name="text">
                                    <string>【Generated CAN Message】</string>
                                </property>
                            </widget>
                        </item>

                        <!-- 第 11 行：结果显示框 -->
                        <item row="11" column="0" colspan="8">
                            <widget class="QLineEdit" name="editResult">
                                <property name="readOnly">
                                    <bool>true</bool>
                                </property>
                                <property name="placeholderText">
                                    <string>Generated CAN message will appear here...</string>
                                </property>
                                <property name="sizePolicy">
                                    <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                                        <horstretch>0</horstretch>
                                        <verstretch>0</verstretch>
                                    </sizepolicy>
                                </property>
                                <property name="minimumSize">
                                    <size>
                                        <width>0</width>
                                        <height>30</height>
                                    </size>
                                </property>
                                <property name="maximumSize">
                                    <size>
                                        <width>16777215</width>
                                        <height>30</height>
                                    </size>
                                </property>
                            </widget>
                        </item>
                    </layout>
                </widget>
            </item>

            <!-- 底部 Spacer（吸收所有剩余垂直空间） -->
            <item>
                <spacer name="bottomSpacer">
                    <property name="orientation">
                        <enum>Qt::Vertical</enum>
                    </property>
                    <property name="sizeHint" stdset="0">
                        <size>
                            <width>20</width>
                            <height>0</height>
                        </size>
                    </property>
                    <property name="sizePolicy">
                        <sizepolicy hsizetype="Minimum" vsizetype="Expanding">
                            <horstretch>0</horstretch>
                            <verstretch>1</verstretch>
                        </sizepolicy>
                    </property>
                </spacer>
            </item>
        </layout>
    </widget>
    <resources/>
    <connections/>
