                <number>10</number>
            </property>

            <!-- 分类标题 -->
            <item>
                <widget class="QLabel" name="categoryGeneral">
                    <property name="text">
                        <string>General</string>
                    </property>
                    <property name="class" stdset="0">
                        <string>settings-title</string>
                    </property>
                </widget>
            </item>

            <!-- 主题 -->
            <item>
                <layout class="QHBoxLayout" name="layoutGeneral1" stretch="1,1">
                    <property name="spacing">
                        <number>20</number>
                    </property>
                    <item>
                        <widget class="QWidget" name="settingsTheme" native="true">
                            <layout class="QHBoxLayout" name="layoutTheme">
                                <item>
                                    <widget class="QLabel" name="labelTheme">
                                        <property name="text">
                                            <string>DarkTheme</string>
                                        </property>
                                    </widget>
                                </item>
                                <item>
                                    <spacer name="horizontalSpacerTheme">
                                        <property name="orientation">
                                            <enum>Qt::Horizontal</enum>
                                        </property>
                                        <property name="sizeHint" stdset="0">
                                            <size>
                                                <width>40</width>
                                                <height>20</height>
                                            </size>
                                        </property>
                                    </spacer>
                                </item>
                                <item>
                                    <widget class="ToggleSwitch" name="toggleTheme">
                                        <property name="text">
                                            <string/>
                                        </property>
                                    </widget>
                                </item>
                            </layout>
                        </widget>
                    </item>
                    <!-- 预留 -->
                    <item>
                        <widget class="QWidget" name="settingsPlaceholder" native="true">
                        </widget>
                    </item>
                </layout>
            </item>

            <!-- 一行整行开关项 -->
            <item>
                <layout class="QHBoxLayout" name="rowFullWidthLayout">
                    <property name="leftMargin">
                        <number>9</number>
                    </property>
                    <item>
                        <widget class="QLabel" name="labelFullWidthOption">
                            <property name="text">
                                <string>TODO Option</string>
                            </property>
                        </widget>
                    </item>
                    <item>
                        <spacer name="horizontalSpacerFullWidth">
                            <property name="orientation">
                                <enum>Qt::Horizontal</enum>
                            </property>
                            <property name="sizeHint" stdset="0">
                                <size>
                                    <width>40</width>
                                    <height>20</height>
                                </size>
                            </property>
                        </spacer>
                    </item>
                    <item>
                        <widget class="QCheckBox" name="checkFullWidthOption">
                            <property name="text">
                                <string/>
                            </property>
                        </widget>
                    </item>
                </layout>
            </item>

            <!-- 弹性空间，将版权标签推到底部 -->
            <item>
                <spacer name="verticalSpacer">
                    <property name="orientation">
                        <enum>Qt::Vertical</enum>
                    </property>
                    <property name="sizeHint" stdset="0">
                        <size>
                            <width>20</width>
                            <height>40</height>
                        </size>
                    </property>
                </spacer>
            </item>

            <!-- 版权署名 -->
            <item>
                <widget class="QLabel" name="copyrightLabel">
                    <property name="text">
                        <string>Copyright © 2026 Joel</string>
                    </property>
                    <property name="alignment">
                        <set>Qt::AlignCenter</set>
                    </property>
                    <property name="styleSheet">
                        <string notr="true">color: #888; font-size: 10pt;</string>
                    </property>
                </widget>
            </item>

        </layout>
    </widget>
    <customwidgets>
